# Вход в админку Keitaro (нужен только человеку, бэкенд их не использует)
LOGIN=
PASSWORD=

# Keitaro Admin API. Ключ: админка Keitaro → Профиль → API ключи
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# Группа и источник новых кампаний (по именам, как в админке). Домен выбирается в форме
KEITARO_GROUP=FORTESTS
KEITARO_SOURCE=FORTESTS

# Страны по умолчанию в форме создания, через запятую
DEFAULT_GEO=AU

# Локальный Postgres из docker-compose (учётка только для разработки)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5434/keitaro
